
import java.util.Scanner;

class PalindromeNumbersLessThanN {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a positive integer N: ");
        int N = sc.nextInt();

        System.out.println("Palindrome numbers less than " + N + " are:");

        for (int num = 1; num < N; num++) {

            int temp = num;
            int rev = 0;

            while (temp > 0) {
                int digit = temp % 10;
                rev = rev * 10 + digit;
                temp = temp / 10;
            }

            if (num == rev) {
                System.out.print(num + " ");
            }
        }

        sc.close();
    }
}
